{
  "name": "picoruby-libs",
  "version": "0.2.0",
  "description": "Load PicoRuby libraries from npm with `require` in PicoRuby.wasm",
  "files": [
    "loader.rb",
    "bin/",
    "lib/"
  ],
  "bin": {
    "picoruby-libs": "bin/picoruby-libs"
  },
  "scripts": {
    "test": "bundle exec rspec",
    "serve": "ruby -run -e httpd . -p 3000",
    "check:builtins": "node scripts/check-builtins.mjs",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "picoruby",
    "picoruby-wasm",
    "ruby",
    "require",
    "loader"
  ],
  "author": "itojum",
  "license": "MIT",
  "homepage": "https://github.com/itojum/picoruby-libs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itojum/picoruby-libs.git"
  },
  "bugs": {
    "url": "https://github.com/itojum/picoruby-libs/issues"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "playwright": "^1.65.1"
  }
}
